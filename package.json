{
  "name": "pebble-xdrip-app",
  "author": "Seppli11",
  "version": "1.0.0",
  "keywords": ["pebble-app"],
  "private": true,
  "scripts": {
    "test:js": "node --test tests/js/**/*.test.js"
  },
  "dependencies": {},
  "pebble": {
    "displayName": "Glucose Monitor",
    "uuid": "d54c32c1-79a8-4f47-a25f-e2c869fb0dd3",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "glucose",
      "direction",
      "error_code",
      "sgv_date"
    ],
    "resources": {
      "media": [
        {"type": "bitmap", "name": "ARROW_DOUBLE_UP",        "file": "images/arrow_double_up.png"        },
        {"type": "bitmap", "name": "ARROW_SINGLE_UP",        "file": "images/arrow_single_up.png"        },
        {"type": "bitmap", "name": "ARROW_FORTY_FIVE_UP",  "file": "images/arrow_forty_five_up.png"  },
        {"type": "bitmap", "name": "ARROW_FLAT",            "file": "images/arrow_flat.png"           },
        {"type": "bitmap", "name": "ARROW_FORTY_FIVE_DOWN","file": "images/arrow_forty_five_down.png"},
        {"type": "bitmap", "name": "ARROW_SINGLE_DOWN",    "file": "images/arrow_single_down.png"    },
        {"type": "bitmap", "name": "ARROW_DOUBLE_DOWN",    "file": "images/arrow_double_down.png"    }
      ]
    }
  }
}
